# Salin file ini menjadi .streamlit/secrets.toml dan isi dengan key asli kamu.
# JANGAN commit secrets.toml (sudah di-.gitignore) — hanya file .example ini yang masuk repo.
#
# Kalau deploy ke Streamlit Community Cloud, tidak perlu file ini di server:
# isi nilai yang sama lewat menu App -> Settings -> Secrets di dashboard mereka.

KAGIRO_API_KEY = "mk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KAGIRO_BASE_URL = "https://api.kagiro.net/v1"

BANDEL_API_KEY = "sk-qwen-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BANDEL_BASE_URL = "https://bandelbanget.xyz/v1"
